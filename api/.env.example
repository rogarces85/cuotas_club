# Base de datos (MariaDB / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=osorno_runners_v2
DB_USER=osorno_app
DB_PASSWORD=

# Better Auth
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787

# Servidor
PORT=8787

# Origen del frontend (CORS / trusted origins)
WEB_ORIGIN=http://localhost:5173

# Correo saliente (Gmail SMTP) — configurado, uso real en M5
MAIL_FROM=tesoreriaor@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tesoreriaor@gmail.com
MAIL_PASSWORD=
