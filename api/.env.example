# ---------------------------------------------------------------------------
# Base de datos (MariaDB / XAMPP)
# ---------------------------------------------------------------------------
# Copia este archivo a api/.env y completa los valores.
#   cp api/.env.example api/.env        (Linux/macOS)
#   Copy-Item api\.env.example api\.env  (Windows PowerShell)
#
# api/.env NO se versiona: contiene la clave real.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=osorno_runners_v2
DB_USER=osorno_app

# Clave del usuario de la aplicación. Elige una y escríbela aquí ANTES de
# correr `npm run db:setup -w api`, porque el script crea el usuario con ella.
DB_PASSWORD=

# Usuario administrador de MySQL, solo para `npm run db:setup -w api`.
# En XAMPP el default es root sin clave.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Genera la tuya con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# Servidor y frontend
# ---------------------------------------------------------------------------
PORT=8787
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Validación de direcciones (opcional)
# ---------------------------------------------------------------------------
# Si tienes una clave de Google Geocoding, el formulario de socios valida las
# direcciones con Google. Sin clave se usa OpenStreetMap (Nominatim), que es
# gratis y no requiere registro. La validación nunca bloquea el guardado.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Correo saliente (Gmail SMTP) — uso real en M5
# ---------------------------------------------------------------------------
# MAIL_PASSWORD no es la clave de la cuenta: es una "contraseña de aplicación"
# de Google (requiere verificación en dos pasos activada).
MAIL_FROM=tesoreriaor@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tesoreriaor@gmail.com
MAIL_PASSWORD=
