{
  "name": "@cuotas-club/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:setup": "node scripts/setup-database.mjs",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@cuotas-club/shared": "*",
    "@better-auth/drizzle-adapter": "^1.7.25",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.25",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
